*
!.gitignore
!user-dirs.dirs
!user-dirs.conf
!mimeapps.list

!wezterm/
!wezterm/*

!kanshi/
!kanshi/*

!fish/
!fish/*
# own functions (machine-specific paths); the portable ones are symlinks into the config.fish submodule
!fish/functions/
!fish/functions/bw.fish
!fish/functions/mitmdump.fish
!fish/functions/mitmproxy.fish
!fish/functions/mitmweb.fish
!fish/functions/sandbox-android.fish

!sway/
!sway/*
!sway/scripts/
!sway/scripts/*

!xkb/
!xkb/symbols/
!xkb/symbols/*

!fontconfig
!fontconfig/*

!dunst/
!dunst/*

!rofi/
!rofi/*

!rofi/scripts/
!rofi/scripts/*

!nvim
!nvim/*

!gtk-3.0
!gtk-3.0/settings.ini

!libfm
!libfm/*

!mpv
!mpv/*

!conky
!conky/*
conky/lan_devices.map

# tools (hand-edited files only; caches stay local)
!htop/
!htop/htoprc
!git/
!git/ignore

# sway session pieces outside .config/sway
!xdg-desktop-portal/
!xdg-desktop-portal/*
# gvfs-metadata masked (-> /dev/null), see .bash_profile
!systemd/
!systemd/user/
!systemd/user/gvfs-metadata.service

# appman: install dir + list of managed AppImages (regenerate with the command in sway/PACKAGES.md)
!appman/
!appman/*

!yazi/
!yazi/*
!wgetrc

# tmux >= 3.1 reads ~/.config/tmux/tmux.conf natively (symlink into the .tmux.conf submodule)
!tmux/
!tmux/*

# readline: bash reads it via INPUTRC (set in .bashrc)
!readline/
!readline/*

# npm user config via NPM_CONFIG_USERCONFIG (set in the shell env files)
!npm/
!npm/npmrc

# systemd --user environment (keeps user services on /files/cache too)
!environment.d/
!environment.d/*
