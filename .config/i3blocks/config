[keyboard]
label=󰌌 KEY 
command=setxkbmap -query | awk '/layout/ {print toupper($2)}'
interval=once
signal=11
color=#BEBAAA

[temperature]
label=󰈸 TEMP 
# Set SENSOR_CHIP here if `sensors` exposes a different temperature label.
command=$HOME/.local/bin/temperature
interval=30

[memory]
label=󰍛 MEM 
command=$HOME/.local/bin/memory
interval=30
color=#BEBAAA

[battery]
label=󱊣 BAT 
command=$HOME/.local/bin/battery
interval=60
bat_number=1

# [cpu]
# label=CPU 
# command=$HOME/.local/bin/cpu_usage
# interval=30

[iface]
label=󰩟 NET 
command=$HOME/.local/bin/iface
interval=60
color=#BEBAAA

[disk-home]
# Home filesystem
label=󰋊 ~ 
command=$HOME/.local/bin/disk
interval=300
color=#AFA99A

[disk-root]
# Root filesystem
label=󰋊 / 
command=$HOME/.local/bin/disk
interval=300
DIR=/
color=#AFA99A

[disk-vms]
# VM storage
label=󰋊 VM 
command=$HOME/.local/bin/disk
interval=300
DIR=/vms/
color=#AFA99A

[time]
label=󰃭 DATE 
command=date '+%d/%m/%y'
interval=3600
color=#A8C0D8

[time-ag]
label=󰥔 AG 
command=TZ=":Atlantic/Reykjavik" date '+%H:%M'
interval=60
color=#8FA1B3

[time-br]
label=󰥔 BR 
command=TZ=":America/Sao_Paulo" date '+%H:%M'
interval=60
color=#8FA1B3

[time-uk]
label=󰥔 UK 
command=TZ=":Europe/London" date '+%H:%M'
interval=60
color=#8FA1B3

[time-nl]
label=󰥔 NL 
command=TZ=":Europe/Amsterdam" date '+%H:%M'
interval=60
color=#A8C0D8
