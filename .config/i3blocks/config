[btc]
label=󰠓 BTC 
command=$HOME/.config/i3blocks/scripts/crypto-rate BTC
interval=3600
color=#D7C27A

[xmr]
label=ɱ XMR 
command=$HOME/.config/i3blocks/scripts/crypto-rate XMR
interval=3600
color=#9BB7A2

