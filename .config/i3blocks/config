# global
# dependency: nerd-fonts-mononoki
# runtime deps: curl, setxkbmap, acpi, lm-sensors, iproute2, xclip
full_text=
align=center
color=#BEBAAA
markup=pango
separator=true
separator_block_width=19

# [volume]
# label=VOL 
